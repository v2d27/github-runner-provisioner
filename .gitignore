.terraform
.terragrunt-cache
lambda_function.zip
*.tfstate.backup
*.tfstate
.terraform.lock.hcl

# Generated by each environment's terragrunt.hcl `generate` blocks — never
# hand-edited, always overwritten on the next terragrunt run.
infrastructure/environments/*/backend.tf
infrastructure/environments/*/provider.tf
infrastructure/root.hcl

# Go Lambda build artifacts (produced by scripts/build.sh + scripts/package.sh)
lambda/*/bootstrap
lambda/*.zip


# Local, environment-specific overrides — real values, never the checked-in
# placeholders. Kept on disk, never committed.
configs/runner.local.yaml
configs/secrets.local.yaml